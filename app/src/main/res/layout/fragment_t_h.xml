<?xml version="1.0" encoding="utf-8"?>
<com.room.layoutmanagerdemo.ui.ThsScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".THSFragment">

    <LinearLayout
            android:layout_width="wrap_content"
            android:orientation="vertical"
            android:layout_height="wrap_content">

        <View
                android:layout_width="200dp"
                android:layout_height="3800dp"
                android:background="#f0b05f" />
    </LinearLayout>

    <TextView
            android:layout_width="match_parent"
            android:layout_height="1800dp"
            android:background="@drawable/chengxiao"
            android:text="Hello" />

    <TextView
            android:layout_width="match_parent"
            android:layout_height="800dp"
            android:text="Hello2" />

    <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="wrap_content">

        <View
                android:layout_width="match_parent"
                android:layout_height="600dp"
                android:background="#f0f00f" />
    </LinearLayout>

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hello3" />

    <FrameLayout
            android:id="@+id/targetView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:background="#000f67"
                    android:layout_height="match_parent">

                <View
                        android:layout_width="match_parent"
                        android:layout_height="800dp"
                        android:background="#ff0f0f" />

                <View
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:background="#00f00f" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <View
                android:id="@+id/tabView"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#00fdcf" />
    </FrameLayout>
</com.room.layoutmanagerdemo.ui.ThsScrollView>