<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.THSNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ff0000"
        tools:context=".ThirdFragment">

    <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <View
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#0ff0f0" />

        <com.room.layoutmanagerdemo.ui.CustomNestedScrollingView
                android:layout_width="match_parent"
                android:id="@+id/customScrollingView"
                android:background="#ff0000"
                android:layout_height="300dp">

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="600dp"
                    android:gravity="center"
                    android:background="#00ff00"
                    android:text="Hello" />

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:background="@color/white"
                    android:text="World" />

            <View
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="#550f50" />
        </com.room.layoutmanagerdemo.ui.CustomNestedScrollingView>

        <View
                android:id="@+id/flag"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="#0ff0f0" />

        <View
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="#ff00ff" />

        <View
                android:layout_width="match_parent"
                android:layout_height="800dp"
                android:background="#0000ff" />
    </LinearLayout>


</androidx.core.widget.THSNestedScrollView>