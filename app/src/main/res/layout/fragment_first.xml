<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.THSNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".FirstFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

        <Button
                android:id="@+id/button_first"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/next"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:background="@color/black"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:layout_marginTop="800dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:listitem="@layout/layout_menu_item_hexagon"
                tools:itemCount="9"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/seekBar3" />

        <Button
                android:id="@+id/button_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/recyclerView" />

        <Button
                android:id="@+id/button_move"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Move"
                app:layout_constraintTop_toBottomOf="@+id/recyclerView"
                app:layout_constraintStart_toEndOf="@+id/button_add" />

        <Button
                android:id="@+id/button_remove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="remove"
                app:layout_constraintTop_toBottomOf="@+id/recyclerView"
                app:layout_constraintStart_toEndOf="@+id/button_move" />

        <com.room.layoutmanagerdemo.ui.ShadowImageView
                android:src="@android:drawable/btn_star_big_on"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/shadowImageView"
                app:layout_constraintStart_toEndOf="@+id/button_first"
                app:layout_constraintTop_toTopOf="@+id/button_first" />

        <SeekBar
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:id="@+id/seekBar"
                android:max="360"
                app:layout_constraintTop_toBottomOf="@+id/button_first"
                app:layout_constraintStart_toStartOf="parent" />

        <SeekBar
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:id="@+id/seekBar2"
                android:max="360"
                app:layout_constraintTop_toBottomOf="@+id/seekBar"
                app:layout_constraintStart_toStartOf="parent" />

        <SeekBar
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:id="@+id/seekBar3"
                android:max="360"
                app:layout_constraintTop_toBottomOf="@+id/seekBar2"
                app:layout_constraintStart_toStartOf="parent" />

        <ImageView
                android:src="@android:drawable/btn_star_big_on"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/imageView"
                app:layout_constraintTop_toBottomOf="@+id/button_first"
                app:layout_constraintBottom_toBottomOf="@+id/seekBar3"
                app:layout_constraintStart_toStartOf="@+id/button_first" />

        <ImageView
                android:src="@android:drawable/btn_star_big_on"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/imageView2"
                app:layout_constraintTop_toBottomOf="@+id/button_first"
                app:layout_constraintBottom_toBottomOf="@+id/seekBar3"
                app:layout_constraintStart_toEndOf="@+id/imageView" />

        <com.room.layoutmanagerdemo.ui.MIUICleanBallView
                android:layout_width="350dp"
                android:layout_height="350dp"
                android:id="@+id/MIUICleanBallView"
                app:layout_constraintTop_toBottomOf="@+id/seekBar3"
                app:layout_constraintStart_toStartOf="@+id/seekBar3" />

        <SeekBar
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:id="@+id/seekBar4"
                android:max="180"
                app:layout_constraintTop_toBottomOf="@+id/MIUICleanBallView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <com.room.layoutmanagerdemo.ui.navigation.BetterNavigationView
                android:layout_width="350dp"
                android:layout_height="350dp"
                android:id="@+id/navigationView"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="000dp"
                app:layout_constraintTop_toBottomOf="@+id/seekBar4" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.THSNestedScrollView>